# Local OpenAI-compatible LLM served by vLLM.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000

# Local embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Qdrant: see repo root .env.example. Default is embedded on disk (no Docker).
QDRANT_MODE=local
QDRANT_PATH=qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_CONSTRAINT_COLLECTION=meshagent_constraints
QDRANT_TOOL_COLLECTION=meshagent_tools