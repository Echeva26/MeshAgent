# Local OpenAI-compatible LLM served by vLLM.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000

# Local embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Base collection names. The app name is appended automatically, for example:
# meshagent_constraints_app_malt, meshagent_tools_app_malt.
QDRANT_CONSTRAINT_COLLECTION=meshagent_constraints
QDRANT_TOOL_COLLECTION=meshagent_tools

# Optional per-app overrides.
# QDRANT_APP_MALT_CONSTRAINT_COLLECTION=meshagent_constraints_app_malt
# QDRANT_APP_MALT_TOOL_COLLECTION=meshagent_tools_app_malt
# QDRANT_APP_CRG_CONSTRAINT_COLLECTION=meshagent_constraints_app_crg
# QDRANT_APP_CRG_TOOL_COLLECTION=meshagent_tools_app_crg
# QDRANT_APP_TRAFFIC_ANALYSIS_CONSTRAINT_COLLECTION=meshagent_constraints_app_traffic_analysis
# QDRANT_APP_TRAFFIC_ANALYSIS_TOOL_COLLECTION=meshagent_tools_app_traffic_analysis
